<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Display cutout (Infinity-V notch: 720x1600, density 300) -->
    <string translatable="false" name="config_mainBuiltInDisplayCutout">
        M 0,0 H -25.6 V 28.44444444444444 H 25.6 V 0 H 0 Z @dp
    </string>
    <string translatable="false" name="config_mainBuiltInDisplayCutoutRectApproximation">
        312,0,408,53
    </string>
    <bool name="config_fillMainBuiltInDisplayCutout">true</bool>

    <!-- Rounded corner radius (60px @ 1.875x = 32dp) -->
    <dimen name="rounded_corner_radius">32dp</dimen>
    <dimen name="rounded_corner_radius_top">32dp</dimen>
    <dimen name="rounded_corner_radius_bottom">32dp</dimen>

    <!-- Wi-Fi and Tethering interfaces -->
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>"ap\\d"</item>
        <item>"swlan\\d"</item>
        <item>"wlan\\d"</item>
    </string-array>
    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>"usb\\d"</item>
        <item>"rndis\\d"</item>
    </string-array>
    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>"bt-pan"</item>
        <item>"bt-dun"</item>
    </string-array>

    <!-- Wi-Fi 5GHz band support -->
    <bool translatable="false" name="config_wifi5ghzSupport">true</bool>
    <bool translatable="false" name="config_wifi_dual_sap_mode">true</bool>

    <!-- Whether device has physical navigation keys (false = software bar) -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Auto brightness -->
    <bool name="config_automatic_brightness_available">true</bool>
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessSettingMaximum">255</integer>
    <integer name="config_screenBrightnessSettingDefault">128</integer>

    <!-- Proximity check on wake -->
    <bool name="config_proximityCheckOnWake">true</bool>

</resources>
